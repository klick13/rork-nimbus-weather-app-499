{
  "expo": {
    "name": "Nimbus Weather",
    "slug": "nimbus-weather-app-jvq2xcw",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rork-b3wrasn8mfa0uxtzs3okj",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rork.nimbus-weather-app-jvq2xcw"
    },
    "android": {
      "label": "Nimbus Hyper-Local Weather App",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.rork.nimbus_weather_app_jvq2xcw"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nimbus uses your location to show hyper-local weather, radar, and alerts for exactly where you are.",
          "locationAlwaysAndWhenInUsePermission": "Nimbus uses your location to show hyper-local weather, radar, and alerts for exactly where you are."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}